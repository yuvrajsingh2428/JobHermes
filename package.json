{
  "name": "jobhermes",
  "version": "1.0.0",
  "description": "Autonomous AI-powered job hunting agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "scan": "ts-node src/index.ts --scan",
    "report": "ts-node src/index.ts --report",
    "resume": "ts-node src/index.ts --resume",
    "cover-letter": "ts-node src/index.ts --cover-letter",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-targets": "ts-node src/index.ts verify-targets",
    "add-company": "ts-node src/index.ts add-company",
    "doctor": "ts-node src/index.ts doctor",
    "signal": "ts-node src/index.ts signal",
    "import-contacts": "ts-node src/index.ts import-contacts",
    "contacts": "ts-node src/index.ts contacts",
    "application": "ts-node src/index.ts application",
    "push-staging": "node scripts/push-staging.js"
  },
  "keywords": [
    "job-hunting",
    "ai",
    "automation",
    "openai",
    "typescript"
  ],
  "author": "Yuvraj Singh",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.1.0",
    "openai": "^4.47.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.63.0",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^5.0.4"
  }
}
